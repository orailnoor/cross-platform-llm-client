<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists/PLIST-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets iOS give PrivateLM more memory before ending it: a bigger share
	     of a model as a phone cluster worker, or bigger models on-device. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
